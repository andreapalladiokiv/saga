{
    "name": "techork/saga",
    "description": "Framework-agnostic Saga pattern implementation for PHP",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "symfony/workflow": "^8.0",
        "symfony/event-dispatcher": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Techork\\Saga\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Techork\\Saga\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.1",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/bus": "^13.0",
        "illuminate/queue": "^13.0"
    },
    "suggest": {
        "illuminate/bus": "Required for Saga\\Laravel integration (^10 || ^11 || ^12 || ^13)",
        "illuminate/queue": "Required for Saga\\Laravel integration (^10 || ^11 || ^12 || ^13)",
        "illuminate/contracts": "Required for Saga\\Laravel integration (^10 || ^11 || ^12 || ^13)",
        "illuminate/support": "Required for the optional SagaServiceProvider (^10 || ^11 || ^12 || ^13)",
        "symfony/event-dispatcher": "Required for the optional event dispatcher (^7.0 || ^8.0)"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Techork\\Saga\\Laravel\\SagaServiceProvider"
            ]
        }
    }
}
